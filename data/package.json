{
  "name": "thefaceanalysis-data",
  "version": "0.1.0",
  "description": "Face measurement statistics from 102 faces (fWHR, midface ratio, symmetry, canthal tilt, pupillary distance), face/eye/lip/nose types and method thresholds, as JSON and CSV. Data CC BY 4.0, code MIT.",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": { "types": "./index.d.ts", "default": "./index.js" },
    "./reference-set.json": "./reference-set.json",
    "./types.json": "./types.json",
    "./changelog.json": "./changelog.json",
    "./face-measurements.csv": "./face-measurements.csv"
  },
  "files": ["index.js", "index.d.ts", "reference-set.json", "types.json", "changelog.json", "face-measurements.csv", "DATA-LICENSE.md"],
  "engines": { "node": ">=20.10" },
  "homepage": "https://thefaceanalysis.com/face-measurement-statistics",
  "repository": { "type": "git", "url": "git+https://github.com/thefaceanalysis/thefaceanalysis-data.git" },
  "keywords": ["face-analysis", "fwhr", "facial-measurements", "face-shape", "dataset", "statistics"],
  "license": "MIT"
}
